<Window x:Class="PubgConnect.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PUBG Connect Setup" 
        Icon="app_icon.ico"
        Height="460" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Background="{StaticResource BgDarkBrush}" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="12,12,0,0" MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PUBG Connect Setup" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="✕" Width="28" Height="28" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" 
                                BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body Container -->
            <Grid Grid.Row="1" Margin="32,20,32,24">
                
                <!-- Step 1: Welcome & Options -->
                <Grid x:Name="OptionsPanel" Visibility="Visible">
                    <StackPanel>
                        <!-- Header Banner -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="56" Height="56" Background="#132822" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="2" CornerRadius="28" Margin="0,0,16,0">
                                <TextBlock Text="🎮" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Install PUBG Connect" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="GameLoop &amp; Android Friend Status Notifier" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Install Location -->
                        <TextBlock Text="Installation Location:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" Margin="0,0,0,6"/>
                        <Border Background="#1E293B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <TextBlock x:Name="InstallPathText" Text="C:\Users\...\AppData\Local\Programs\PUBGConnect" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>

                        <!-- Options Checkboxes -->
                        <StackPanel Margin="0,0,0,20">
                            <CheckBox x:Name="DesktopShortcutCheck" Content="Create Desktop Shortcut" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,10"/>
                            <CheckBox x:Name="StartMenuCheck" Content="Create Start Menu Shortcut" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,10"/>
                            <CheckBox x:Name="AutoStartCheck" Content="Start quietly in system tray with Windows &amp; GameLoop" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <!-- Install Button -->
                        <Button Content="Install Now" Style="{StaticResource PrimaryButtonStyle}" Height="46" Click="InstallButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Step 2: Progress Panel -->
                <Grid x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Installing PUBG Connect..." FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="StatusText" Text="Extracting application files..." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <ProgressBar x:Name="InstallProgressBar" Height="10" Foreground="{StaticResource AccentGreenBrush}" Background="#1E293B" BorderThickness="0" Margin="0,0,0,12"/>
                        <TextBlock x:Name="PercentText" Text="0%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Step 3: Finished Panel -->
                <Grid x:Name="FinishedPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" Background="#132822" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="2" CornerRadius="32" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Installation Complete!" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="PUBG Connect is ready to use and connected to cloud." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,24"/>

                        <CheckBox x:Name="LaunchAfterFinishCheck" Content="Launch PUBG Connect now" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Button Content="Finish" Style="{StaticResource PrimaryButtonStyle}" Width="200" Height="44" Click="FinishButton_Click" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
