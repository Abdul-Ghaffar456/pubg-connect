<Window x:Class="PubgConnect.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PubgConnect.Client.ViewModels"
        xmlns:views="clr-namespace:PubgConnect.Client.Views"
        mc:Ignorable="d"
        Title="PUBG Connect - GameLoop Friend Notifier" 
        Height="680" Width="960" MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>
        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <views:RegisterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FriendsViewModel}">
            <views:FriendsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddFriendViewModel}">
            <views:AddFriendView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RequestsViewModel}">
            <views:RequestsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/> <!-- Custom TitleBar -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="#0A0D15" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="PUBG Connect" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Window Control Buttons (Minimize / Close to Tray) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Click="MinimizeButton_Click" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Width="40" Height="36" Cursor="Hand"/>
                    <Button Content="✕" Click="CloseButton_Click" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Width="40" Height="36" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- App Main Layout -->
            <Grid Grid.Row="1">
                <!-- If NOT logged in (Login/Register view centered) -->
                <ContentControl Content="{Binding CurrentViewModel}"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"/>

                <!-- If Logged In (Sidebar Navigation + Active View) -->
                <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar Navigation -->
                    <Border Grid.Column="0" Background="#111625" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Current User Card -->
                                <RowDefinition Height="Auto"/> <!-- Status Indicator -->
                                <RowDefinition Height="*"/>    <!-- Navigation Buttons -->
                                <RowDefinition Height="Auto"/> <!-- Logout Button -->
                            </Grid.RowDefinitions>

                            <!-- Current User Header Card -->
                            <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentUser.Username}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Friend ID: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentUser.FriendId}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live My PUBG Status Card -->
                            <Border Grid.Row="1" Background="#0B0F19" CornerRadius="8" Padding="10" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="MY PUBG STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding MyStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Nav Menu Buttons -->
                            <StackPanel Grid.Row="2">
                                <!-- Friends List Button -->
                                <Button Content="👥   Friends List" Command="{Binding NavigateTabCommand}" CommandParameter="Friends" 
                                        Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Height="44" Margin="0,0,0,8"/>

                                <!-- Add Friend Button -->
                                <Button Content="➕   Add Friend" Command="{Binding NavigateTabCommand}" CommandParameter="AddFriend" 
                                        Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Height="44" Margin="0,0,0,8"/>

                                <!-- Friend Requests Button with Badge -->
                                <Grid Margin="0,0,0,8">
                                    <Button Content="📩   Friend Requests" Command="{Binding NavigateTabCommand}" CommandParameter="Requests" 
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Height="44"/>
                                    
                                    <!-- Request Badge Counter -->
                                    <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="10" Width="20" Height="20" 
                                            HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                                            Visibility="{Binding PendingRequestsCount, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding PendingRequestsCount}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Settings / GameLoop Button -->
                                <Button Content="⚙️   Settings &amp; GameLoop" Command="{Binding NavigateTabCommand}" CommandParameter="Settings" 
                                        Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Height="44" Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- Logout Button -->
                            <Button Grid.Row="3" Content="🚪  Log Out" Command="{Binding LogoutCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource AccentRedBrush}" Height="40"/>
                        </Grid>
                    </Border>

                    <!-- Main View Content Area -->
                    <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
