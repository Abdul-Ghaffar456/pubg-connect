<UserControl x:Class="PubgConnect.Client.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="550">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="FRIENDS LIST" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                    <Run Text="{Binding OnlineCount, Mode=OneWay}"/>
                    <Run Text=" online of "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text=" friends"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Separator Grid.Row="1" Background="{StaticResource BorderBrushDark}" Margin="0,0,0,16"/>

        <!-- Friends Items Control -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Empty state when no friends -->
                <TextBlock Text="No friends added yet. Use 'Add Friend' tab with your friend's 6-character ID!" 
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,40,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Friends}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,12" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Dot Indicator -->
                                    <Ellipse Grid.Column="0" Width="14" Height="14" 
                                             Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                             VerticalAlignment="Center" Margin="0,0,16,0"/>

                                    <!-- User Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Username}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding FriendId, StringFormat=' ({0})'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Status Description Text -->
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" 
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>

                                        <!-- Playing Platform & Duration (if online in PUBG) -->
                                        <TextBlock FontSize="12" Foreground="{StaticResource AccentGreenBrush}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="PlayingPubg">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding Platform, Converter={StaticResource PlatformToTextConverter}}"/>
                                            <Run Text=" • Online for "/>
                                            <Run Text="{Binding PlayingDurationMinutes, Mode=OneWay}"/>
                                            <Run Text=" min"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Actions (Mute Notifications / Remove Friend) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Mute Button -->
                                        <Button Command="{Binding DataContext.ToggleMuteFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" ToolTip="Toggle Mute Notifications">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="🔔 Notify ON"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNotificationMuted}" Value="True">
                                                                <Setter Property="Text" Value="🔕 Muted"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Remove Button -->
                                        <Button Content="Remove" 
                                                Command="{Binding DataContext.RemoveFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource AccentRedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
