<UserControl x:Class="PubgConnect.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="550">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SETTINGS &amp; GAMELOOP CONFIGURATION" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Manage notifications, startup behavior, privacy, and process detection" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Separator Grid.Row="1" Background="{StaticResource BorderBrushDark}" Margin="0,0,0,24"/>

        <!-- Settings Cards Scroll -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- GameLoop Detection Card (Section 17) -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🎮 GameLoop &amp; PUBG Mobile Detection" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="GameLoop Launcher:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="❌ Not Detected"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameLoopDetected}" Value="True">
                                                <Setter Property="Text" Value="✅ GameLoop Detected"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="PUBG Mobile Status:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding GameLoopStatusText}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}"/>
                        </Grid>

                        <CheckBox Content="Automatically start / open PUBG Connect when GameLoop or PUBG starts" 
                                  IsChecked="{Binding StartWithGameLoop}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,4"/>

                        <Separator Background="{StaticResource BorderBrushDark}" Margin="0,8,0,12"/>

                        <!-- Action Buttons -->
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Re-detect GameLoop" Command="{Binding RedetectGameLoopCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Toggle PUBG Test Mode" Command="{Binding ToggleSimulationModeCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </WrapPanel>

                        <!-- Simulation controls if enabled -->
                        <Border Margin="0,12,0,0" Padding="12" Background="#0F172A" CornerRadius="8" Visibility="{Binding IsSimulatedMode, Converter={StaticResource BoolToVisConverter}}">
                            <DockPanel>
                                <TextBlock Text="⚠️ Test Mode Active (Simulates process start/stop without GameLoop running)" Foreground="{StaticResource AccentYellowBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <Button Content="{Binding SimulatedPubgActive, Converter={StaticResource StatusToTextConverter}}" Command="{Binding ToggleSimulatedPubgCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Notifications Card (Section 16) -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🔔 Desktop Notifications" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <CheckBox Content="Enable Windows Toast Notifications" IsChecked="{Binding NotificationsEnabled}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Play notification sound when friend starts PUBG" IsChecked="{Binding NotificationSoundEnabled}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- System &amp; Startup Card -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="💻 System &amp; Windows Startup" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <CheckBox Content="Automatically start PUBG Connect with Windows" IsChecked="{Binding StartWithWindows}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Privacy Settings Card (Section 15) -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🔒 Privacy &amp; Status Controls" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <CheckBox Content="Share PUBG status with accepted friends" IsChecked="{Binding ShareStatus}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Allow friend requests from other users" IsChecked="{Binding AllowFriendRequests}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Show playing duration (e.g. Online for 12 min)" IsChecked="{Binding ShowPlayingDuration}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Server Connection Card (Internet / LAN) -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🌐 Server Connection (Internet / LAN)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Set your central server host address so your friends on other PCs across the Internet can connect." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="40" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Save Server URL" Command="{Binding SaveServerUrlCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="16,0"/>
                        </Grid>

                        <TextBlock Text="{Binding ServerSaveMessage}" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" Margin="2,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
