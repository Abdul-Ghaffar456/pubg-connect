<UserControl x:Class="PubgConnect.Client.Views.AddFriendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="650">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ADD FRIEND" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Search for a user by their unique 6-character Friend ID (e.g. B3M88X)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Separator Grid.Row="1" Background="{StaticResource BorderBrushDark}" Margin="0,0,0,24"/>

        <!-- Main Form Content -->
        <StackPanel Grid.Row="2" MaxWidth="520" HorizontalAlignment="Left">
            <!-- Search Card -->
            <Border Style="{StaticResource GlassCardStyle}" Width="480" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Friend ID (6 Characters)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Grid.Column="0" Text="{Binding SearchFriendId, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBoxStyle}" CharacterCasing="Upper" MaxLength="6"
                                 Height="44" FontSize="16" FontWeight="SemiBold" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="1" Content="🔍 Search" Command="{Binding SearchCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" Height="44" Padding="20,0" FontSize="14"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Search Result Card -->
            <Border Style="{StaticResource GlassCardStyle}" Width="480" Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding FoundUser, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FoundUser.Username}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding FoundUser.FriendId, StringFormat='Friend ID: {0}'}" FontSize="13" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="➕ Send Request" Command="{Binding SendRequestCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="16,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Status Feedback Message -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" Margin="4,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
